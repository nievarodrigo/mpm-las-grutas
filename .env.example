# Supabase (Project Settings > API)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Resend (Dashboard > API Keys)
RESEND_API_KEY=

# Casilla que recibe las notificaciones de consultas por email.
# Mientras se use el modo sandbox de Resend, tiene que ser la misma
# casilla registrada como dueña de la cuenta de Resend.
OWNER_EMAIL=

# Panel de administración (/admin) — token de Vercel scopeado al proyecto,
# con expiración, usado solo server-side para consultar Web Analytics.
VERCEL_API_TOKEN=
